DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/mydb?schema=public"

OPENROUTER_API_KEY=""
# Modelo usado pelo endpoint /context/preview-v2 (intent classification com tool calling).
# Default é o Llama 3.3 70B no free tier. Outras opções free com tools:
#   - meta-llama/llama-3.3-70b-instruct:free
#   - qwen/qwen3-next-80b-a3b-instruct:free
#   - openai/gpt-oss-120b:free
#   - z-ai/glm-4.5-air:free
# Pra qualidade superior (com crédito): anthropic/claude-haiku-4.5
INTENT_MODEL_ID="meta-llama/llama-3.3-70b-instruct:free"
# Lista de fallback do OpenRouter (CSV, máximo 3 itens). Quando o primeiro estiver
# rate-limited upstream, o OpenRouter tenta o próximo automaticamente. Ajuda no
# free tier onde providers como Venice (Llama) ficam saturados.
INTENT_MODEL_FALLBACKS="meta-llama/llama-3.3-70b-instruct:free,qwen/qwen3-next-80b-a3b-instruct:free,openai/gpt-oss-120b:free"

# Obtained at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must match an "Authorized redirect URI" configured in the Google console
GOOGLE_REDIRECT_URI="http://localhost:3001/auth/google/callback"
# Where the user lands after a successful OAuth callback
OAUTH_POST_LOGIN_REDIRECT="/"

PORT=3001
NODE_ENV=development
